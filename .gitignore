# Local-only demo script, never for the public repo
dan_demo.py

# Local astronomy data, downloads, and generated artifacts.
# `fits_downloads/` has no leading slash, so it matches at any depth -- it
# covers the archive download root in its current home under `data/` as well
# as a stale one left at the repository root.
fits_downloads/
downloads/
artifacts/
cache/
.cache/
work/
staging/
*.manifest.json
isochrone_cache/

# NOTE: never re-add a bare `data/` here. `data/` is the repository's tracked
# fixture tree (39 FITS frames plus recorded reference solves, ~175 MB); the
# pattern would ignore all of it, and a fixture added later would silently
# fail to be committed. The one thing under it that must stay untracked is the
# archive download root, already covered by `fits_downloads/` above.

# Local credentials and environment overrides
.env
.env.*
!.env.example

# Python build/test output
__pycache__/
*.py[cod]
*$py.class
.python-version
.venv/
venv/
env/
build/
dist/
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.pyright/
.tox/
.nox/
.coverage
.coverage.*
coverage.xml
htmlcov/

# JavaScript / TypeScript build output
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Notebook checkpoints
.ipynb_checkpoints/

# Logs and temporary files
*.log
*.tmp
*.bak

# Editor and OS files
.vscode/
.DS_Store
Thumbs.db
*.swp
*~
